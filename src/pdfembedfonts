# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="pdfembedfonts"
[[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] && export TEXTDOMAINDIR="${TEXTDOMAINDIR:-@CMAKE_INSTALL_FULL_DATADIR@/locale}"

# shellcheck disable=SC1091
. gettext.sh


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local lrm=""
   local rlm=""
   # TRANSLATORS: Text direction: LTR (Left-to-Right) or RTL (Right-to-Left)
   if [ "$(gettext "LTR")" = "RTL" ] ; then
      lrm=$'\xe2\x80\x8e'
      rlm=$'\xe2\x80\x8f'
   fi
   local homepage="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local repository="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   cat >&2 <<EOF
${header}$(gettext "Usage:")${reset}
${cmd}${program}${reset} ${arg}input_pdf${reset} ${arg}output_pdf${reset}
	${syn}[${reset}${opt}-O${reset} ${syn}|${reset} ${opt}--optimise${reset} ${syn}|${reset} ${opt}--optimize${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   # TRANSLATORS: Informational message at the end of usage:
   # "For further information, see the man page for <manpage>, read the documentation at <url>, examine the source code at <url>, or consult your favourite LLM.".
   printf >&2 "$(gettext "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.")\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------


# ###### Version ############################################################
version () {
   echo "System-Info @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]]; then
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi
options="$(${GETOPT} -o Ohv --long optimise,optimize,help,version -a -- "$@")"
# shellcheck disable=SC2181
if [[ $? -ne 0 ]]; then
   usage "$0" 1
fi

OPTIMISE=0
eval set -- "${options}"
while [ $# -gt 0 ] ; do
   case "$1" in
      -O | --optimise | --optimize)
         OPTIMISE=1
         ;;
      -h | --help)
         usage "$0" 0
         # shift
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
  esac
  shift
done
if [ $# -ne 2 ] ; then
   usage "$0" 1
fi
INPUT_PDF="$1"
OUTPUT_PDF="$2"
if [ ! -e "${INPUT_PDF}" ] ; then
   # TRANSLATORS: Error message when the input PDF file cannot be found. ${INPUT_PDF} is the file path.
   eval_gettext >&2 "ERROR: PDF file \${INPUT_PDF} does not exist!"
   echo >&2
   exit 1
fi


# ====== Perform conversion =================================================

# ------ Using PDF/X --------------------------------------------------------
if [ ${OPTIMISE} -eq 1 ] ; then
   ( ps2pdf -dPDFSETTINGS=/prepress -dCompatibilityLevel=1.7 "${INPUT_PDF}" "${OUTPUT_PDF}"-tmp.pdf && qpdf --linearize "${OUTPUT_PDF}"-tmp.pdf "${OUTPUT_PDF}" ) || cp "${INPUT_PDF}" "${OUTPUT_PDF}"
   rm -f "${OUTPUT_PDF}"-tmp.pdf
else
    ps2pdf -dPDFSETTINGS=/prepress -dCompatibilityLevel=1.7 "${INPUT_PDF}" "${OUTPUT_PDF}"
fi
