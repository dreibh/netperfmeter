# ###### Bash completion for netperfmeter ###################################
_netperfmeter()
{
   # Based on:
   # * https://www.benningtons.net/index.php/bash-completion/
   # * /usr/share/bash-completion/completions/dd
   # * https://unix.stackexchange.com/questions/781584/complete-compgen-fails-to-suggest-when-options-contain-colon

   # This is necessary to properly handle ":" in completion words, in order
   # to properly handle IPv6 addresses!
   local COMP_WORDBREAKS="${COMP_WORDBREAKS//:}"

   local cur prev words cword
   if type -t _comp_initialize >/dev/null; then
      _comp_initialize || return
   elif type -t _init_completion >/dev/null; then
      _init_completion || return
   else
      # Manual initialization for older bash completion versions:
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      # shellcheck disable=SC2034
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      # shellcheck disable=SC2034,SC2124
      words="${COMP_WORDS[@]}"
      # shellcheck disable=SC2034
      cword="${COMP_CWORD}"
   fi

   local dscpNames="BE DF CS0 LE CS1 AF11 AF12 AF13 CS2 AF21 AF22 AF23 CS3 AF31 AF32 AF33 CS4 AF41 AF42 AF43 CS5 VA EF CS6 CS7"
   local flowLabelKeywords="default auto reflect"

   # echo "cur=${cur} prev=${prev} words=${words[@]} cword=${cword}"
   # echo ""

   # ====== Parameters ======================================================
   local flowSpec=0
   if [ "${cword}" -gt 1 ] ; then
      if [ "${prev}" == "-t" ]      || [ "${prev}" == "--tcp" ]   || \
         [ "${prev}" == "-m" ]      || [ "${prev}" == "--mptcp" ] || \
         [ "${prev}" == "-u" ]      || [ "${prev}" == "--udp" ]   || \
         [ "${prev}" == "-d" ]      || [ "${prev}" == "--dccp" ]  || \
         [ "${prev}" == "-s" ]      || [ "${prev}" == "--sctp" ]  || \
         [ "${prev}" == "-k" ]      || [ "${prev}" == "--quic" ] ; then
         flowSpec=1
      elif [[ "${prev}" =~ ^(const|default|exp|normal|pareto|truncnormal|uniform) ]] ; then
         flowSpec=1
      fi

      if [ "${flowSpec}" -eq 1 ] ; then
         case "${cur}" in
            # ====== Flowspec ==================================================
            const*       | \
            default:*    | \
            exp*         | \
            normal*      | \
            pareto*      | \
            truncnormal* | \
            uniform*)
               # shellcheck disable=SC2155,SC2001
               local base="$(echo "${cur}" | sed -e 's/:[^:]*$/:/')"
               # shellcheck disable=SC2155,SC2001
               local blocks="$(echo "${base}" | tr -cd ":" | wc -c)"

               if [[ "${cur}" != default:* ]] && [ "${blocks}" -lt 4 ] ; then
                  if [[ "${cur}" =~ (^|:)(const|exp|normal|pareto|truncnormal|uniform)([0-9]+)$ ]] ; then
                     mapfile -t COMPREPLY < <(compgen -W "${cur}0 ${cur}1 ${cur}2 ${cur}3 ${cur}4 ${cur}5 ${cur}6 ${cur}7 ${cur}8 ${cur}9 ${cur}, ${cur}:" -- "${cur}")
                     compopt -o nospace
                     return
                  elif [[ "${cur}" =~ (^|:)(const|exp|normal|pareto|truncnormal|uniform)$ ]] ; then
                     mapfile -t COMPREPLY < <(compgen -W "${cur}0 ${cur}1 ${cur}2 ${cur}3 ${cur}4 ${cur}5 ${cur}6 ${cur}7 ${cur}8 ${cur}9 ${cur}," -- "${cur}")
                     compopt -o nospace
                     return
                  else
                     mapfile -t COMPREPLY < <(compgen -W "${base}const ${base}exp ${base}normal ${base}pareto ${base}truncnormal ${base}uniform" -- "${cur}" )
                     compopt -o nospace
                     return
                  fi
               else
                  local optTail="${cur##*:}"
                  case "${optTail}" in
                     tc=*)
                        local tcCandidates=""
                        local dscp
                        for dscp in ${dscpNames} ; do
                           tcCandidates+=" ${base}tc=${dscp}"
                        done
                        mapfile -t COMPREPLY < <(compgen -W "${tcCandidates}" -- "${cur}")
                        compopt -o nospace
                        return
                        ;;
                     fl=*)
                        local flCandidates=""
                        local fl
                        for fl in ${flowLabelKeywords} ; do
                           flCandidates+=" ${base}fl=${fl}"
                        done
                        mapfile -t COMPREPLY < <(compgen -W "${flCandidates}" -- "${cur}")
                        compopt -o nospace
                        return
                        ;;
                     debug=* | error_on_abort=* | nodelay=*)
                        local optName="${optTail%%=*}"
                        mapfile -t COMPREPLY < <(compgen -W "${base}${optName}=on ${base}${optName}=off" -- "${cur}")
                        compopt -o nospace
                        return
                        ;;
                     cmt=*)
                        mapfile -t COMPREPLY < <(compgen -W "${base}cmt=off ${base}cmt=cmt ${base}cmt=cmtrpv1 ${base}cmt=cmtrpv2 ${base}cmt=mptcp ${base}cmt=like-mptcp" -- "${cur}")
                        compopt -o nospace
                        return
                        ;;
                  esac
                  mapfile -t COMPREPLY < <(compgen -W "
   ${base}cc=
   ${base}ccid=
   ${base}cmt=
   ${base}debug=
   ${base}defragtimeout=
   ${base}description=
   ${base}error_on_abort=
   ${base}fl=
   ${base}hbassocmaxrtx=
   ${base}hbinterval=
   ${base}hbpathmaxrtx=
   ${base}id=
   ${base}maxmsgsize=
   ${base}nodelay=
   ${base}onoff=
   ${base}ordered=
   ${base}rcvbuf=
   ${base}reliable=
   ${base}rtx_timeout=
   ${base}rtx_trials=
   ${base}sndbuf=
   ${base}tc=
   ${base}unordered=
   ${base}unreliable=
   ${base}v6only
   " -- "${cur}")
                  compopt -o nospace
                  return
               fi
               ;;
         esac
      fi

      case "${prev}" in
         #  ====== Generic value ============================================
         -A | --activenodename    | \
         -P | --passivenodename   | \
         -o | --sndbuf            | \
         -i | --rcvbuf            | \
         -N | --count             | \
         -T | --runtime           | \
         --control-hbinterval     | \
         --control-hbpathmaxrtx   | \
         --control-hbassocmaxrtx)
            return
            ;;
         # ====== Traffic Class / DSCP ======================================
         -Q | --control-tc)
            mapfile -t COMPREPLY < <(compgen -W "${dscpNames}" -- "${cur}")
            return
            ;;
         # ====== IPv6 Flow Label ===========================================
         -F | --control-fl)
            mapfile -t COMPREPLY < <(compgen -W "${flowLabelKeywords}" -- "${cur}")
            return
            ;;
         # ====== Local address =============================================
         -L | --local | \
         -l | --control-local)
            # Suggest local IP addresses:
            # NOTE: For IPv6, ":" must have been removed from COMP_WORDBREAKS
            #       See comment above!
            local addresses
            if [ -x  /usr/sbin/ip ] ; then
               addresses="$( /usr/sbin/ip addr show | awk '/[ ]+inet/ { print $2 }' | sed -e 's#/.*$##')"
            elif [ -x /sbin/ifconfig ] ; then
               addresses="$(/sbin/ifconfig | awk '/[ \t]+inet/ { print $2 }' | sed -e 's#/.*$##')"
            fi
            mapfile -t COMPREPLY < <(compgen -W "${addresses}" -- "${cur}")
            return
            ;;
         # ====== Scalar/vector file pattern ================================
         -C | --config | \
         -S | --scalar | \
         -V | --vector)
            _filedir
            return
            ;;
         # ====== Special case: key file ====================================
         -K | --tls-key)
            _filedir '@(key|pem)'
            return
            ;;
         # ====== Special case: certificate file ============================
         -I | --tls-ca | \
         -J | --tls-cert)
            _filedir '@(crt|pem)'
            return
            ;;
         # ====== Special case: hostname ====================================
         -H | --tls-hostname)
            mapfile -t COMPREPLY < <( compgen -W "$(hostname -f)" -- "${cur}" )
            return
            ;;
         # ====== Special case: log file ====================================
         --logappend | \
         --logfile)
            _filedir '@(log)'
            return
            ;;
         # ====== Special case: on/off ======================================
         --logcolor)
            mapfile -t COMPREPLY < <(compgen -W "on off" -- "${cur}")
            return
            ;;
      esac

   # ====== Port (passive side) or Address:Port (active side) ===============
   else
      mapfile -t COMPREPLY < <(compgen -W 'localhost:9000 9000' -- "${cur}")
      return
   fi


   # ====== All options =====================================================
   local opts

   # ------ Active side -----------------------------------------------------
   # echo "cword=$cword D=${words[1]}"
   if [ "${cword}" -ge 2 ] && [[ ! "${words[1]}" =~ ^[0-9]+$ ]] ; then
      if [ ${flowSpec} -eq 0 ] ; then
         opts="
-x
--control-over-sctp
-y
--control-over-tcp
-w
--control-over-mptcp
-z
--control-over-quic
-L
--local
-l
--control-local
-K
--tls-key
-J
--tls-cert
-I
--tls-ca
-H
--tls-hostname
-Q
--control-tc
-F
--control-fl
--control-hbinterval
--control-hbpathmaxrtx
--control-hbassocmaxrtx
-6
--v6only
--display
--nodisplay
-o
--sndbuf
-i
--rcvbuf
-N
--count
-T
--runtime
-C
--config
-S
--scalar
-V
--vector
-A
--activenodename
-P
--passivenodename
--loglevel
--logcolor
--logfile
--logappend
-t
--tcp
-m
--mptcp
-u
--udp
-d
--dccp
-s
--sctp
-k
--quic
-q
--quiet
-!
--verbose
-h
--help
-v
--version
"
      else
         opts="const default: exp normal pareto truncnormal uniform"
      fi

   # ------ Passive side ----------------------------------------------------
   else
      opts="
-x
--control-over-sctp
-X
--no-control-over-sctp
-y
--control-over-tcp
-Y
--no-control-over-tcp
-w
--control-over-mptcp
-W
--no-control-over-mptcp
-z
--control-over-quic
-Z
--no-control-over-quic
-L
--local
-l
--control-local
-K
--tls-key
-J
--tls-cert
-I
--tls-ca
-Q
--control-tc
-F
--control-fl
--control-hbinterval
--control-hbpathmaxrtx
--control-hbassocmaxrtx
-6
--v6only
--display
--nodisplay
--loglevel
--logcolor
--logfile
--logappend
-q
--quiet
-!
--verbose
-h
--help
-v
--version
"
   fi

   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}" )
   [ ${flowSpec} -eq 1  ] && compopt -o nospace
   return 0
}

complete -F _netperfmeter netperfmeter
