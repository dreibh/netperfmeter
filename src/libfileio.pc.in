prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libfileio
Description: Cross-platform C++ system for reading/writing compressed files
Version: @PROJECT_VERSION@

Libs: -L${libdir} -lfileio
Libs.private: @PC_LIBS_PRIVATE@
Cflags: -I${includedir} -I${includedir}/fileio @PC_CFLAGS@
