# ###### Bash completion for createsummary ###############################
_createsummary()
{
   # Based on: https://www.benningtons.net/index.php/bash-completion/
   local cur prev words cword
   if type -t _comp_initialize >/dev/null; then
      _comp_initialize || return
   elif type -t _init_completion >/dev/null; then
      _init_completion || return
   else
      # Manual initialization for older bash completion versions:
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      # shellcheck disable=SC2034
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      # shellcheck disable=SC2034,SC2124
      words="${COMP_WORDS[@]}"
      # shellcheck disable=SC2034
      cword="${COMP_CWORD}"
   fi

   case "${prev}" in
      -F | --format)
         local formats="plain bz2 gzip xz lzma zstd"
         mapfile -t COMPREPLY < <(compgen -W "${formats}" -- "${cur}")
         return
         ;;
      -c | --compress)
         compopt -o nosort 2>/dev/null || true   # No sorting (Bash >= 4.4)
         local format=""
         local i
         for ((i = 1; i < cword; i++)); do
            if [[ "${words[i]}" == "-F" || "${words[i]}" == "--format" ]]; then
               format="${words[i+1]}"
            fi
         done

         local levels
         case "${format}" in
            plain)
               levels="0"
               ;;
            bz2 | bzip2)
               levels="$(echo {1..9})"
               ;;
            gzip | gz | xz | lzma)
               levels="$(echo {0..9})"
               ;;
            zstd | zst | zstandard)
               levels="$(echo {1..22})"
               ;;
            *)
               levels="$(echo {0..22})"
               ;;
         esac

         mapfile -t COMPREPLY < <(compgen -W "${levels}" -- "${cur}")
         return
         ;;
      -s | --separator)
         return
         ;;
   esac

   # ====== All options =====================================================
   local opts="
-b
--batch
-i
--interactive
-F
--format
-c
--compress
-s
--separator
-l
--line-numbers
-n
--no-line-numbers
-p
--split
-a
--no-split
-r
--ignore-scalar-file-errors
-q
--quiet
-h
--help
-v
--version
"
   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}" )
   return 0
}

complete -F _createsummary createsummary
