# ###### Bash completion for combinesummaries ###############################
_combinesummaries()
{
   # Based on: https://www.benningtons.net/index.php/bash-completion/
   local cur prev words cword
   if type -t _comp_initialize >/dev/null; then
      _comp_initialize || return
   elif type -t _init_completion >/dev/null; then
      _init_completion || return
   else
      # Manual initialization for older bash completion versions:
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      # shellcheck disable=SC2034
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      # shellcheck disable=SC2034,SC2124
      words="${COMP_WORDS[@]}"
      # shellcheck disable=SC2034
      cword="${COMP_CWORD}"
   fi

   if [ "${cword}" -eq 1 ] && [[ "${cur}" != -* ]] ; then
      _filedir
      return
   else
      case "${prev}" in
         -c | --compress)
            compopt -o nosort 2>/dev/null || true   # No sorting (Bash >= 4.4)

            # Find output file name from command line
            local outfile=""
            local i
            local skip=0
            for ((i = 1; i < ${#COMP_WORDS[@]}; i++)); do
               if ((skip)); then
                  skip=0
                  continue
               fi
               local w="${COMP_WORDS[i]}"
               if [[ "$i" -eq "$COMP_CWORD" ]]; then
                  continue
               fi
               case "$w" in
                  -c | --compress | -s | --separator)
                     skip=1
                     ;;
                  --compress=* | --separator=*)
                     ;;
                  -*)
                     ;;
                  *)
                     outfile="$w"
                     break
                     ;;
               esac
            done

            local format=""
            local ext="${outfile##*.}"
            case "${ext,,}" in
               bz2)
                  format="bz2"
                  ;;
               gz)
                  format="gzip"
                  ;;
               xz | lzma)
                  format="xz"
                  ;;
               zst | zstd)
                  format="zstd"
                  ;;
               "")
                  format=""
                  ;;
               *)
                  format="plain"
                  ;;
            esac

            case "${format}" in
               plain)
                  mapfile -t COMPREPLY < <(compgen -W "0" -- "${cur}")
                  ;;
               zstd)
                  mapfile -t COMPREPLY < <(compgen -W "{1..22}" -- "${cur}")
                  ;;
               gzip | xz)
                  mapfile -t COMPREPLY < <(compgen -W "{0..9}" -- "${cur}")
                  ;;
               bz2)
                  mapfile -t COMPREPLY < <(compgen -W "{1..9}" -- "${cur}")
                  ;;
               *)
                  mapfile -t COMPREPLY < <(compgen -W "{0..22}" -- "${cur}")
                  ;;
            esac
            return
            ;;
         -s | --separator)
            return
            ;;
      esac
   fi

   # ====== All options =====================================================
   local opts="
-c
--compress
-s
--separator
-l
--line-numbers
-n
--no-line-numbers
-q
--quiet
-h
--help
-v
--version
"
   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}" )
   return 0
}

complete -F _combinesummaries combinesummaries
