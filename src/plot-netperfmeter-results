# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="plot-netperfmeter-results"
[[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] && export TEXTDOMAINDIR="${TEXTDOMAINDIR:-@CMAKE_INSTALL_FULL_DATADIR@/locale}"

# shellcheck disable=SC1091
. gettext.sh


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local lrm=""
   local rlm=""
   # TRANSLATORS: Text direction: LTR (Left-to-Right) or RTL (Right-to-Left)
   if [ "$(gettext "LTR")" = "RTL" ] ; then
      lrm=$'\xe2\x80\x8e'
      rlm=$'\xe2\x80\x8f'
   fi
   local homepage="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local repository="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   cat >&2 <<EOF
${header}$(gettext "Usage:")${reset}
${cmd}${program}${reset} ${arg}config_name${reset}
	${syn}[${reset}${opt}-w${reset} ${syn}|${reset} ${opt}--own-file${reset} ${syn}|${reset} ${opt}--ownfile${reset}${syn}]${reset}
	${syn}[${reset}${opt}-k${reset} ${syn}|${reset} ${opt}--keep-summaries${reset}${syn}]${reset}
	${syn}[${reset}${opt}-p${reset} ${syn}|${reset} ${opt}--per-flow-plots${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   # TRANSLATORS: Informational message at the end of usage:
   # "For further information, see the man page for <manpage>, read the documentation at <url>, examine the source code at <url>, or consult your favourite LLM.".
   # shellcheck disable=SC2059
   printf >&2 "$(gettext "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.")\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------


# ###### Version ############################################################
version () {
   echo "plot-netperfmeter-results @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if [ -z "${GETOPT}" ] || "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]]; then
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi

if ! options="$("${GETOPT}" -o wkphv --long own-file,ownfile,keep-summaries,per-flow-plots,help,version -a -- "$@")"; then
   usage "$0" 1
fi

KEEP_SUMMARIES=0
PER_FLOW_PLOTS=0
PLOT_OWN_FILE="FALSE"
eval set -- "${options}"
while [ $# -gt 0 ] ; do
   case "$1" in
      -w | --own-file | --ownfile)
         PLOT_OWN_FILE="TRUE"
         ;;
      -k | --keep-summaries)
         KEEP_SUMMARIES=1
         ;;
      -p | --per-flow-plots)
         PER_FLOW_PLOTS=1
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
   esac
   shift
done
if [ $# -ne 1 ] ; then
   usage "$0" 1
fi
CONFIG_FILE="$1"
if [ ! -e "${CONFIG_FILE}" ] ; then
   # TRANSLATORS: Error message when the configuration file cannot be found. ${CONFIG_FILE} is the file path.
   eval_gettext >&2 "ERROR: Config file \${CONFIG_FILE} not found!"
   echo >&2
   exit 1
fi


# ====== Check vector files =================================================
# TRANSLATORS: Status message before validating input vector files.
echo -e "\e[34m$(gettext "Checking vector files ...")\e[0m"
VECTOR_ACTIVE_NODE=""
VECTOR_PASSIVE_NODE=""
NUM_FLOWS=0
# shellcheck disable=SC1090
. "${CONFIG_FILE}"
if [ -z "${VECTOR_PASSIVE_NODE}" ] || [ -z "${VECTOR_ACTIVE_NODE}" ] || [ "${NUM_FLOWS}" -lt 1 ] ; then
   # TRANSLATORS: Error message when the configuration file lacks valid vector file paths or flow count.
   gettext >&2 "ERROR: Bad vector file configuration!"
   echo >&2
   exit 1
fi
if [ ! -e "${VECTOR_ACTIVE_NODE}" ] ; then
   # TRANSLATORS: Error message when the active node vector file cannot be found. ${VECTOR_ACTIVE_NODE} is the file path.
   eval_gettext >&2 "ERROR: Vector file \${VECTOR_ACTIVE_NODE} of active node not found!"
   echo >&2
   exit 1
fi
if [ ! -e "${VECTOR_PASSIVE_NODE}" ] ; then
   # TRANSLATORS: Error message when the passive node vector file cannot be found. ${VECTOR_PASSIVE_NODE} is the file path.
   eval_gettext >&2 "ERROR: Vector file \${VECTOR_PASSIVE_NODE} of passive node not found!"
   echo >&2
   exit 1
fi
# shellcheck disable=SC2001
OUTPUT_PREFIX="$(echo "${CONFIG_FILE}" | sed -e "s/.config$//g")"

# TRANSLATORS: Header for printing configuration summary.
gettext "Configuration:"
echo
# TRANSLATORS: Configuration line for active node vector input. Placeholders: ${NAME_ACTIVE_NODE} node name, ${VECTOR_ACTIVE_NODE} file path.
eval_gettext " * Input of Active Node \"\${NAME_ACTIVE_NODE}\": \${VECTOR_ACTIVE_NODE}"
echo
# TRANSLATORS: Configuration line for passive node vector input. Placeholders: ${NAME_PASSIVE_NODE} node name, ${VECTOR_PASSIVE_NODE} file path.
eval_gettext " * Input of Passive Node \"\${NAME_PASSIVE_NODE}\": \${VECTOR_PASSIVE_NODE}"
echo
# TRANSLATORS: Configuration line for output file prefix. ${OUTPUT_PREFIX} is the output path prefix.
eval_gettext " * Output Prefix: \${OUTPUT_PREFIX}"
echo


# ====== Create combined data files =========================================
# TRANSLATORS: Status message before merging vector files with combinesummaries.
echo -e "\e[34m$(gettext "Combining vector files for plotting input ...")\e[0m"
SEARCH_PATHS=". /usr/local/bin /usr/bin"
COMBINESUMMARIES="combinesummaries"
for searchPath in ${SEARCH_PATHS} ; do
   if [ -e "${searchPath}/${COMBINESUMMARIES}" ] ; then
      COMBINESUMMARIES="${searchPath}/combinesummaries"
      break
   fi
done
if ! command -v "${COMBINESUMMARIES}" >/dev/null 2>&1 ; then
   # TRANSLATORS: Error message when combinesummaries executable cannot be found.
   gettext >&2 "ERROR: Cannot find combinesummaries!"
   echo >&2
   exit 1
fi

SUMMARY_NAME="${OUTPUT_PREFIX}-summary.data.bz2"
(
   echo -e "--values=\"\"${NAME_ACTIVE_NODE}\"\t1\""
   echo "--input=${VECTOR_ACTIVE_NODE}"
   echo -e "--values=\"\"${NAME_PASSIVE_NODE}\"\t0\""
   echo "--input=${VECTOR_PASSIVE_NODE}"
) | "${COMBINESUMMARIES}" "${SUMMARY_NAME}" $'NodeName\tIsActive' --separator $'\t' --line-numbers --quiet

FLOW_SUMMARY_NAME="${OUTPUT_PREFIX}-flows.data.bz2"
(
   i=0
   while [ $i -lt ${NUM_FLOWS} ] ; do
      flowDescriptionVar="\$FLOW$i""_DESCRIPTION"
      activeVectorVar="\$FLOW$i""_VECTOR_ACTIVE_NODE"
      passiveVectorVar="\$FLOW$i""_VECTOR_PASSIVE_NODE"
      flowDescription=""
      activeVector=""
      passiveVector=""
      eval flowDescription="${flowDescriptionVar}"
      eval activeVector="${activeVectorVar}"
      eval passiveVector="${passiveVectorVar}"

      echo -e "--values=\"\"${flowDescription}\"\t$i\t\"${NAME_ACTIVE_NODE}\"\t1\""
      echo "--input=${activeVector}"
      echo -e "--values=\"\"${flowDescription}\"\t$i\t\"${NAME_PASSIVE_NODE}\"\t0\""
      echo "--input=${passiveVector}"
      i=$((i+1))
   done
) | "${COMBINESUMMARIES}" "${FLOW_SUMMARY_NAME}" $'FlowName\tFlowID\tNodeName\tIsActive' --separator $'\t' --line-numbers --quiet


# ====== Plot the results ===================================================
# TRANSLATORS: Status message before invoking GNU R plotting script.
echo -e "\e[34m$(gettext "Plotting the vectors ...")\e[0m"

# ------ Locate plotting scripts --------------------------------------------
SEARCH_PATHS=". /usr/share/netperfmeter /usr/local/share/netperfmeter"
PLOT_PROGRAM_DIR=""
PLOT_PROGRAM_SCRIPT="plot-netperfmeter-results.R"
for searchPath in ${SEARCH_PATHS} ; do
   if [ -e "${searchPath}/${PLOT_PROGRAM_SCRIPT}" ] ; then
      PLOT_PROGRAM_DIR=${searchPath}
      break
   fi
done
if [ -z "${PLOT_PROGRAM_DIR}" ] ; then
   # TRANSLATORS: Error message when the R plotting script cannot be found. ${PLOT_PROGRAM_SCRIPT} is the script file name.
   eval_gettext >&2 "ERROR: Cannot find \${PLOT_PROGRAM_SCRIPT}!"
   echo >&2
   exit 1
elif [ "${PLOT_PROGRAM_DIR}" = "." ] ; then
   # TRANSLATORS: Notice when using the R plotting script from the current working directory. Placeholders: ${PLOT_PROGRAM_SCRIPT} script name, ${PLOT_PROGRAM_DIR} directory path.
   eval_gettext "Using \${PLOT_PROGRAM_SCRIPT} from \${PLOT_PROGRAM_DIR}"
   echo
fi


# ------ Call the R script for plotting -------------------------------------
R CMD BATCH --slave --vanilla \
   "--args
      programDirectory=\"${PLOT_PROGRAM_DIR}\"
      configFile=\"${CONFIG_FILE}\"
      summaryFile=\"${SUMMARY_NAME}\"
      flowSummaryFile=\"${FLOW_SUMMARY_NAME}\"
      pdfFilePrefix=\"${OUTPUT_PREFIX}\"
      perFlowPlots=${PER_FLOW_PLOTS}
      plotOwnFile=${PLOT_OWN_FILE}" \
   "${PLOT_PROGRAM_DIR}/${PLOT_PROGRAM_SCRIPT}" /dev/stdout


# ====== Remove temporary files =============================================
# TRANSLATORS: Status message before removing temporary combined data files.
echo -e "\e[34m$(gettext "Cleaning up ...")\e[0m"
if [ ${KEEP_SUMMARIES} -eq 0 ] ; then
   rm -f "${SUMMARY_NAME}" "${FLOW_SUMMARY_NAME}"
fi
