#!/usr/bin/env bash

set -euxo pipefail

if [ "$1" == "on" ] ; then
   for chain in INPUT OUTPUT ; do
      sudo iptables -F $chain
      for port in sport dport ; do
         sudo iptables -A $chain -p udp  --$port 8999:9001 -j DROP
         sudo iptables -A $chain -p tcp  --$port 8999:9001 -j DROP
         sudo iptables -A $chain -p sctp --$port 9000:9001 -j DROP
      done
   done

   sudo iptables -L INPUT -nv
   sudo iptables -L OUTPUT -nv

   echo "*** BLOCKING NetPerfMeter traffic! ***"
else
   sudo iptables -F INPUT
   sudo iptables -F OUTPUT
   echo "*** Flushed ***"
fi
